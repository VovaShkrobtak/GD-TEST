corner_radius_top_left = 14
corner_radius_top_right = 14
corner_radius_bottom_right = 14
corner_radius_bottom_left = 14
shadow_color = Color(0, 0, 0, 0.55)
shadow_size = 24

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_menu")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.008, 0.012, 0.024, 1)
mouse_filter = 2

[node name="GlowA" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.035, 0.07, 0.12, 0.28)
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(480, 420)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_panel")

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="SpacerTop" type="Control" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2

[node name="Title" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.88, 0.94, 1, 1)
theme_override_colors/font_shadow_color = Color(0.1, 0.35, 0.75, 0.7)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 3
theme_override_font_sizes/font_size = 52
text = "SURFACE"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.7, 0.88, 1)
theme_override_font_sizes/font_size = 16
text = "A WALKING PROTOTYPE IN IMPOSSIBLE SPACES"
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2

[node name="StartButton" type="Button" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
focus_neighbor_top = NodePath("../StartButton")
theme_override_colors/font_color = Color(0.92, 0.97, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(0.8, 0.9, 1, 1)
theme_override_font_sizes/font_size = 25
text = "START  •  RANDOM ROOM"

[node name="Hint" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.48, 0.55, 0.66, 1)
theme_override_font_sizes/font_size = 14
text = "Every start uses a fresh seed.\nFloor, walls, ceiling and interior structures are regenerated."
horizontal_alignment = 1

[node name="Status" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.36, 0.8, 0.72, 1)
theme_override_font_sizes/font_size = 13
text = "EVERY ROOM IS DIFFERENT"
horizontal_alignment = 1

[node name="SpacerBottom" type="Control" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 22)
layout_mode = 2

[connection signal="pressed" from="Center/Panel/VBox/StartButton" to="." method="_on_start_button_pressed"]
